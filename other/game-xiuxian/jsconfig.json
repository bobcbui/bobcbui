{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true
  },
  "include": ["src/**/*.js", "jsconfig.json"],
  "exclude": ["node_modules", "lib"]
}
